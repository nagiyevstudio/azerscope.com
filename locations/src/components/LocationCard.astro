---
import type { Lang } from "../config";
import type { LocationEntry } from "../lib/locations";
import { coverPath, locationPath } from "../lib/locations";
import { t } from "../lib/i18n";

interface Props {
  lang: Lang;
  location: LocationEntry;
}

const { lang, location } = Astro.props;
const data = location.data;
const cover = coverPath(data);
const href = locationPath(lang, data.slug);
const alt = data.cover.alt[lang] || data.name[lang];
---

<a
  href={href}
  class="card-surface group block overflow-hidden transition-transform duration-200 hover:-translate-y-1 hover:border-gold-400/30"
>
  <div class="relative aspect-video overflow-hidden bg-space-800">
    {
      cover ? (
        <img
          src={cover}
          alt={alt}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
          onerror="this.style.display='none'"
        />
      ) : null
    }
    <div class="pointer-events-none absolute inset-0 flex items-center justify-center text-mist-600">
      <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
        <circle cx="12" cy="12" r="9" />
        <circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none" />
        <circle cx="17" cy="7" r="0.9" fill="currentColor" stroke="none" />
      </svg>
    </div>
    <span class="gold-chip absolute right-3 top-3 backdrop-blur-sm">
      {t(lang, "bortle")} {data.bortle}
    </span>
  </div>
  <div class="p-5">
    <h3 class="text-lg font-semibold text-white">{data.name[lang]}</h3>
    <p class="mt-1 text-sm text-gold-400/90">{data.region[lang]}</p>
    <p class="mt-3 text-sm leading-relaxed text-mist-300 line-clamp-3">{data.summary[lang]}</p>
  </div>
</a>
