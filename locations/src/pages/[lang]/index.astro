---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocationCard from "../../components/LocationCard.astro";
import { LANGS, isLang, type Lang } from "../../config";
import { getPublishedLocations, catalogPath, locationPath, absoluteUrl } from "../../lib/locations";
import { t } from "../../lib/i18n";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang;
if (!isLang(langParam)) {
  return Astro.redirect(catalogPath("en"));
}
const lang: Lang = langParam;

const locations = await getPublishedLocations();
const title = t(lang, "catalogTitle");
const description = t(lang, "catalogIntro");
const alternates = LANGS.map((l) => ({ lang: l, href: absoluteUrl(catalogPath(l)) }));
---

<BaseLayout
  lang={lang}
  title={`${title} — AzerScope`}
  description={description}
  canonical={absoluteUrl(catalogPath(lang))}
  alternates={alternates}
>
  <section class="mx-auto max-w-6xl px-4 pb-16 pt-12 sm:px-6 sm:pt-16">
    <h1 class="max-w-3xl text-3xl font-bold leading-tight text-white sm:text-4xl">{title}</h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-mist-300">{description}</p>

    {
      locations.length === 0 ? (
        <p class="card-surface mt-10 p-8 text-center text-mist-400">{t(lang, "emptyCatalog")}</p>
      ) : (
        <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {locations.map((location) => (
            <LocationCard lang={lang} location={location} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
